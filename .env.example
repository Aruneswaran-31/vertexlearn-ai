# Server
PORT=4000
NODE_ENV=development
DB_PATH=data/vertexlearn.sqlite

# Auth — always replace this outside local development
JWT_SECRET=vertexlearn-dev-secret-change-me
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=7

# Optional: enables Claude-generated answers, summaries and quiz drafts.
# Without it the local grounded retrieval engine is used.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Seed demo users/courses when the database is empty
SEED_DEMO_DATA=true
